# --- Nebius Token Factory (required) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
MODEL_FAST=nvidia/Nemotron-3_5-Lightning
MODEL_JUDGE=nvidia/Nemotron-3-Ultra-550b-a55b
# How each model returns structured output: tool_forced | tool_auto | text_json
STRUCTURED_MODE_FAST=tool_forced
STRUCTURED_MODE_JUDGE=tool_forced
# Nemotron reasoning per model (off for FAST: reasoning can eat the token budget before the JSON)
THINKING_FAST=false
THINKING_JUDGE=true

# --- Tavily (required) ---
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic          # basic uses fewer credits than advanced
TAVILY_MAX_RESULTS=5
TAVILY_RAW_CONTENT=true            # full page text so sources get claim-relevant passages (no extra credits)
TAVILY_CHUNKS_PER_SOURCE=3         # advanced depth only

# --- Pipeline limits ---
MAX_INPUT_CHARS=5000
MAX_CLAIMS=3
QUERIES_PER_CLAIM=3
MAX_SOURCES_PER_CLAIM=8
MAX_SOURCES_PER_DOMAIN=2
SOURCE_CHARS=2500                  # characters of claim-relevant passages per source given to the model
MAX_EXTRA_QUERIES=2                # debate round
CHECK_TIMEOUT_SECONDS=240
SEARCH_CACHE_HOURS=24

# --- Protection ---
RATE_LIMIT_PER_IP=5                # checks per IP per window
RATE_LIMIT_WINDOW_SECONDS=600
DAILY_CHECK_CAP=150
MAX_CONCURRENT_CHECKS=3
# Proxies in front of the app that append to X-Forwarded-For (1 = one load balancer/ingress).
# The per-IP limit uses the entry the outermost of them added; entries further left can be forged
# by the client. 0 = no proxy: ignore X-Forwarded-For.
TRUSTED_PROXY_HOPS=1

# --- Cost display (USD per 1M tokens, copy from Token Factory catalog) ---
PRICE_FAST_IN=0.06
PRICE_FAST_OUT=0.24
PRICE_JUDGE_IN=1.0
PRICE_JUDGE_OUT=3.0

# --- App ---
DATA_DIR=./data
LOG_LEVEL=INFO
